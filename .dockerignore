# VCS
.git
.gitignore
.gitattributes

# Dependencies (never copy host node_modules into a build context)
**/node_modules

# Build output
**/dist
**/.output
**/.vinxi
**/.tanstack

# Generated code (regenerated during the Docker build)
**/src/generated

# Environment & secrets (values are supplied at runtime)
**/.env
**/.env.*
!**/.env.example

# Logs
**/*.log
npm-debug.log*

# Editor / OS
.vscode
.idea
.DS_Store

# Misc
coverage
