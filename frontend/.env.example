# Frontend environment configuration (copy to `.env` to override defaults).

# Optional — absolute base URL of the deployed backend API.
# When set, the frontend calls the backend directly (e.g. on Vercel where the
# frontend and backend are separate projects):
#   VITE_BACKEND_API_URL=https://your-backend-project.vercel.app/api
# When unset, API calls fall back to the same-origin `/api` prefix (used by the
# Vite dev proxy and by deployments that rewrite `/api/*` to the backend).
VITE_BACKEND_API_URL=
