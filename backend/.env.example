# ==============================================================
# Bilal Portfolio — Backend environment configuration
# Copy this file to `.env` and adjust the values as needed.
# ==============================================================

# PostgreSQL connection string (Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Nodemailer — Gmail SMTP for email delivery
# Use a Gmail App Password (https://myaccount.google.com/apppasswords)
# — NOT your regular Gmail password.
GMAIL_USER=your.gmail.address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# Destination inbox for contact notifications
CONTACT_EMAIL=your.gmail.address@gmail.com

# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Comma-separated list of allowed CORS origins
# (e.g. the deployed frontend URL: https://your-portfolio.vercel.app)
CORS_ORIGINS=http://localhost:5173

# Global rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Contact form rate limiting (stricter, anti-spam)
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5

# AI chat provider: openai | groq | gemini
# Only the selected provider's API key is required — the others may stay empty.
AI_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Chat endpoint rate limiting
CHAT_RATE_LIMIT_WINDOW_MS=900000
CHAT_RATE_LIMIT_MAX=30
