generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@map("contact_submissions")
}
